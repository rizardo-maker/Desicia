# Optional environment variables. Defaults work without a .env file.
# Supply through your process manager or: node --env-file=.env server-build/index.js
PORT=3000
NODE_ENV=production
# Set to durable private storage in deployment. Never put it under dist/public.
DATA_DIR=.data
LEAD_RETENTION_DAYS=30
# Only needed when the browser origin and request Host differ behind a trusted proxy.
# Comma-separated exact origins; do not use a wildcard.
ALLOWED_ORIGINS=
